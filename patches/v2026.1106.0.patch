diff --git a/ui/src/i18n/display-catalog.test.ts b/ui/src/i18n/display-catalog.test.ts
new file mode 100644
index 000000000..f85e2bea7
--- /dev/null
+++ b/ui/src/i18n/display-catalog.test.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it } from "vitest";
+
+const catalogs = import.meta.glob<Record<string, unknown>>("./display/*.json", { eager: true, import: "default" });
+
+function placeholders(text: string) {
+  return Array.from(text.matchAll(/\{\{[^{}]+\}\}/g), (match) => match[0]).sort();
+}
+
+function urls(text: string) {
+  return Array.from(text.matchAll(/\bhttps?:\/\/[^\s<>"')]+/gi), (match) => match[0]).sort();
+}
+
+function hasHtmlTag(text: string) {
+  return /<\/?[A-Za-z][A-Za-z0-9:-]*(?:\s[^>]*)?>/.test(text);
+}
+
+describe("display catalogs", () => {
+  it("ships at least one catalog", () => {
+    expect(Object.keys(catalogs).length).toBeGreaterThan(0);
+  });
+
+  for (const [path, catalog] of Object.entries(catalogs)) {
+    it(`${path} only holds safe string translations keyed by normalized source text`, () => {
+      const errors: string[] = [];
+      for (const [source, translated] of Object.entries(catalog)) {
+        if (typeof translated !== "string" || translated.trim() === "") {
+          errors.push(`${source}: translation must be a non-empty string`);
+          continue;
+        }
+        if (source !== source.replace(/\s+/g, " ").trim()) errors.push(`${source}: key is not normalized`);
+        if (placeholders(source).join("|") !== placeholders(translated).join("|")) errors.push(`${source}: placeholders differ`);
+        if (hasHtmlTag(translated) && !hasHtmlTag(source)) errors.push(`${source}: adds an HTML tag`);
+        const sourceUrls = new Set(urls(source));
+        if (urls(translated).some((url) => !sourceUrls.has(url))) errors.push(`${source}: adds a URL`);
+        if (/javascript\s*:/i.test(translated) && !/javascript\s*:/i.test(source)) errors.push(`${source}: adds javascript:`);
+        const limit = Math.min(2_000, Math.max(source.length * 4 + 64, source.length + 128));
+        if (translated.length > limit) errors.push(`${source}: translation is too long`);
+      }
+      expect(errors).toEqual([]);
+    });
+  }
+});
diff --git a/ui/src/i18n/display-dom.test.ts b/ui/src/i18n/display-dom.test.ts
new file mode 100644
index 000000000..fa9438a1b
--- /dev/null
+++ b/ui/src/i18n/display-dom.test.ts
@@ -0,0 +1,111 @@
+// @vitest-environment jsdom
+
+import { describe, expect, it } from "vitest";
+import { createDomTranslator, installDisplayDateLocale, startDomTranslation } from "./display-dom";
+
+const catalog = {
+  Mine: "À moi",
+  "Month to Date": "Mois en cours",
+  "updated {{v0}} ago": "mis à jour il y a {{v0}}",
+  "{{v0}} running, {{v1}} paused": "{{v0}} en cours, {{v1}} en pause",
+  "Search agents": "Rechercher des agents",
+  "New Agent": "Nouvel agent",
+  "{{v0}} agent": "agent {{v0}}",
+  "{{v0}} tasks": "{{v0}} tâches",
+  "{{v0}} task": "{{v0}} tâche",
+};
+
+const tick = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+describe("createDomTranslator", () => {
+  it("translates exact labels and rich templates", () => {
+    const translate = createDomTranslator(catalog);
+    expect(translate("  Mine ")).toBe("  À moi ");
+    expect(translate("updated 5 min ago")).toBe("mis à jour il y a 5 min");
+    expect(translate("3 running, 1 paused")).toBe("3 en cours, 1 en pause");
+  });
+
+  it("does not touch translated output, poor templates or free text", () => {
+    const translate = createDomTranslator(catalog);
+    expect(translate("Nouvel agent")).toBeNull();
+    expect(translate("Research agent")).toBeNull();
+    expect(translate("Prepare the client demo")).toBeNull();
+  });
+
+  it("translates counted nouns only through catalog entries", () => {
+    const translate = createDomTranslator(catalog);
+    expect(translate("3 tasks")).toBe("3 tâches");
+    expect(translate("1 task")).toBe("1 tâche");
+    expect(translate("2 Zenith")).toBeNull();
+  });
+});
+
+describe("startDomTranslation", () => {
+  it("never touches editors, code, inputs or opted-out zones", () => {
+    document.body.innerHTML = `
+      <nav><button title="Search agents">Mine</button></nav>
+      <pre>Mine</pre><code>Mine</code><textarea>Mine</textarea>
+      <div contenteditable="true">Mine</div><div data-no-translate>Mine</div>
+      <div class="ProseMirror"><p>Mine</p></div><input value="Mine" placeholder="Search agents">
+      <select><option>Mine</option></select>`;
+    const stop = startDomTranslation(document.body, createDomTranslator(catalog));
+    expect(document.querySelector("nav button")?.textContent).toBe("À moi");
+    expect(document.querySelector("nav button")?.getAttribute("title")).toBe("Rechercher des agents");
+    for (const selector of ["pre", "code", "textarea", "[contenteditable]", "[data-no-translate]", ".ProseMirror p", "option"]) {
+      expect(document.querySelector(selector)?.textContent).toBe("Mine");
+    }
+    expect(document.querySelector("input")?.value).toBe("Mine");
+    expect(document.querySelector("input")?.getAttribute("placeholder")).toBe("Rechercher des agents");
+    stop();
+  });
+
+  it("keeps attributes inside markdown, editors and opted-out zones as written", async () => {
+    document.body.innerHTML = `
+      <div class="paperclip-markdown"><img alt="New Agent" src="data:,"></div>
+      <div data-no-translate><button title="Search agents" aria-label="New Agent">x</button></div>
+      <div class="ProseMirror"><input placeholder="Search agents"></div>
+      <form><textarea placeholder="Search agents"></textarea></form>`;
+    const stop = startDomTranslation(document.body, createDomTranslator(catalog));
+    expect(document.querySelector("img")?.getAttribute("alt")).toBe("New Agent");
+    expect(document.querySelector("[data-no-translate] button")?.getAttribute("title")).toBe("Search agents");
+    expect(document.querySelector("[data-no-translate] button")?.getAttribute("aria-label")).toBe("New Agent");
+    expect(document.querySelector(".ProseMirror input")?.getAttribute("placeholder")).toBe("Search agents");
+    expect(document.querySelector("form textarea")?.getAttribute("placeholder")).toBe("Rechercher des agents");
+    const later = document.createElement("img");
+    later.setAttribute("alt", "New Agent");
+    document.querySelector(".paperclip-markdown")?.append(later);
+    await tick();
+    expect(later.getAttribute("alt")).toBe("New Agent");
+    stop();
+  });
+
+  it("follows later text updates and insertions", async () => {
+    document.body.innerHTML = '<span id="label">Mine</span>';
+    const stop = startDomTranslation(document.body, createDomTranslator(catalog));
+    const label = document.getElementById("label");
+    const text = label?.firstChild;
+    if (text) text.nodeValue = "Month to Date";
+    await tick();
+    expect(label?.textContent).toBe("Mois en cours");
+    const paragraph = document.createElement("p");
+    paragraph.textContent = "2 running, 0 paused";
+    document.body.append(paragraph);
+    await tick();
+    expect(paragraph.textContent).toBe("2 en cours, 0 en pause");
+    stop();
+  });
+});
+
+describe("installDisplayDateLocale", () => {
+  it("formats forced en-US dates in the display locale but keeps parts and resolved options", () => {
+    installDisplayDateLocale(globalThis, "fr");
+    const date = new Date("2026-10-29T12:00:00Z");
+    expect(date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })).toBe("29 oct. 2026");
+    expect(new Intl.DateTimeFormat("en-US", { month: "long", timeZone: "UTC" }).format(date)).toBe("octobre");
+    const parts = new Intl.DateTimeFormat("en-US", { weekday: "short", timeZone: "UTC" }).formatToParts(date);
+    expect(parts.find((part) => part.type === "weekday")?.value).toBe("Thu");
+    expect(new Intl.DateTimeFormat("en-US", { timeZone: "UTC" }).resolvedOptions().locale).toBe("en-US");
+    expect(new Intl.DateTimeFormat("en-US") instanceof Intl.DateTimeFormat).toBe(true);
+    expect(date.toLocaleDateString("de-DE", { timeZone: "UTC" })).toBe("29.10.2026");
+  });
+});
diff --git a/ui/src/i18n/display-dom.ts b/ui/src/i18n/display-dom.ts
new file mode 100644
index 000000000..b9edf2b38
--- /dev/null
+++ b/ui/src/i18n/display-dom.ts
@@ -0,0 +1,229 @@
+export type DisplayCatalog = Record<string, string>;
+export type DomTextTranslator = (raw: string) => string | null;
+
+const SKIP_SELECTOR = [
+  "code",
+  "pre",
+  "script",
+  "style",
+  "textarea",
+  "input",
+  "kbd",
+  "samp",
+  "[contenteditable=\"\"]",
+  "[contenteditable=\"true\"]",
+  "[data-no-translate]",
+  ".ProseMirror",
+  "[data-lexical-editor]",
+  ".mdxeditor",
+  ".cm-editor",
+  ".monaco-editor",
+  ".prose",
+  ".paperclip-markdown",
+  "[data-markdown]",
+].join(",");
+
+const DISPLAY_ATTRIBUTES = ["title", "aria-label", "placeholder", "alt"];
+const COUNTED_NOUN = /^(\d[\d\s.,]*)\s+([A-Za-z]+)$/;
+const MAX_TEMPLATE_INPUT = 240;
+const MAX_CACHE_SIZE = 20_000;
+
+interface TemplateMatcher {
+  pattern: RegExp;
+  keys: string[];
+  translation: string;
+  anchor: string;
+}
+
+function hasOwn(catalog: DisplayCatalog, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(catalog, key);
+}
+
+function escapeRegExp(text: string): string {
+  return text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
+
+function fillPlaceholders(template: string, values: Record<string, string>): string {
+  return template.replace(/\{\{(v\d+)\}\}/g, (token, key: string) => values[key] ?? token);
+}
+
+export function buildTemplateMatchers(catalog: DisplayCatalog): TemplateMatcher[] {
+  const matchers: TemplateMatcher[] = [];
+  for (const [source, translation] of Object.entries(catalog)) {
+    if (!source.includes("{{v")) continue;
+    const parts = source.split(/(\{\{v\d+\}\})/);
+    const fixedParts = parts.filter((_, index) => index % 2 === 0);
+    const anchor = fixedParts.reduce((longest, part) => (part.trim().length > longest.length ? part.trim() : longest), "");
+    const fixedWords = fixedParts.join(" ").match(/[A-Za-z]{2,}/g) ?? [];
+    if (fixedWords.length < 2 || anchor.replace(/[^A-Za-z]/g, "").length < 4) continue;
+    const keys = parts.filter((_, index) => index % 2 === 1).map((part) => part.slice(2, -2));
+    const pattern = new RegExp(`^${parts.map((part, index) => (index % 2 === 1 ? "(.+?)" : escapeRegExp(part))).join("")}$`, "s");
+    matchers.push({ pattern, keys, translation, anchor });
+  }
+  return matchers.sort((left, right) => right.anchor.length - left.anchor.length);
+}
+
+export function createDomTranslator(catalog: DisplayCatalog): DomTextTranslator {
+  const templates = buildTemplateMatchers(catalog);
+  const translatedOutputs = new Set(Object.values(catalog).map((value) => value.replace(/\s+/g, " ").trim()));
+  const cache = new Map<string, string | null>();
+
+  const lookup = (text: string): string | null => {
+    if (hasOwn(catalog, text)) return catalog[text];
+    const counted = COUNTED_NOUN.exec(text);
+    if (counted) {
+      const key = `{{v0}} ${counted[2]}`;
+      if (hasOwn(catalog, key)) return fillPlaceholders(catalog[key], { v0: counted[1] });
+    }
+    if (text.length >= MAX_TEMPLATE_INPUT) return null;
+    for (const template of templates) {
+      if (!text.includes(template.anchor)) continue;
+      const match = template.pattern.exec(text);
+      if (!match) continue;
+      const values = Object.fromEntries(template.keys.map((key, index) => [key, match[index + 1]]));
+      return fillPlaceholders(template.translation, values);
+    }
+    return null;
+  };
+
+  return (raw: string) => {
+    const text = raw.replace(/\s+/g, " ").trim();
+    if (text.length < 2 || !/[A-Za-z]{2}/.test(text)) return null;
+    if (translatedOutputs.has(text) && !hasOwn(catalog, text)) return null;
+    let translated = cache.get(text);
+    if (translated === undefined) {
+      translated = lookup(text);
+      if (cache.size > MAX_CACHE_SIZE) cache.clear();
+      cache.set(text, translated);
+    }
+    if (translated === null || translated === text) return null;
+    return (raw.match(/^\s*/)?.[0] ?? "") + translated + (raw.match(/\s*$/)?.[0] ?? "");
+  };
+}
+
+export function startDomTranslation(root: Node, translate: DomTextTranslator): () => void {
+  const owned = new WeakMap<Node, string>();
+  const isSkipped = (element: Element | null) => !element || Boolean(element.closest(SKIP_SELECTOR));
+
+  const translateTextNode = (node: Node) => {
+    const parent = node.parentElement;
+    if (isSkipped(parent)) return;
+    if (parent?.tagName === "OPTION" && !parent.hasAttribute("value")) return;
+    const value = node.nodeValue;
+    if (value === null || owned.get(node) === value) return;
+    const translated = translate(value);
+    if (translated !== null && translated !== value) {
+      node.nodeValue = translated;
+      owned.set(node, translated);
+    }
+  };
+
+  const isAttributeSkipped = (element: Element) => {
+    const formField = element.tagName === "INPUT" || element.tagName === "TEXTAREA";
+    return isSkipped(formField ? element.parentElement ?? element.ownerDocument.documentElement : element);
+  };
+
+  const translateAttributes = (element: Element) => {
+    if (isAttributeSkipped(element)) return;
+    for (const attribute of DISPLAY_ATTRIBUTES) {
+      const value = element.getAttribute(attribute);
+      if (!value) continue;
+      const marker = `data-display-${attribute}`;
+      if (element.getAttribute(marker) === value) continue;
+      const translated = translate(value);
+      if (translated !== null && translated !== value) {
+        element.setAttribute(attribute, translated);
+        element.setAttribute(marker, translated);
+      }
+    }
+  };
+
+  const walk = (node: Node) => {
+    if (node.nodeType === Node.TEXT_NODE) {
+      translateTextNode(node);
+      return;
+    }
+    if (node.nodeType !== Node.ELEMENT_NODE && node.nodeType !== Node.DOCUMENT_FRAGMENT_NODE) return;
+    if (node.nodeType === Node.ELEMENT_NODE) {
+      translateAttributes(node as Element);
+      if (isSkipped(node as Element)) return;
+    }
+    const document = node.ownerDocument ?? (node as Document);
+    const walker = document.createTreeWalker(node, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT);
+    for (let current = walker.nextNode(); current; current = walker.nextNode()) {
+      if (current.nodeType === Node.TEXT_NODE) translateTextNode(current);
+      else translateAttributes(current as Element);
+    }
+  };
+
+  walk(root);
+  const view = (root.ownerDocument ?? (root as Document)).defaultView;
+  if (!view) return () => {};
+  const observer = new view.MutationObserver((records) => {
+    for (const record of records) {
+      if (record.type === "characterData") translateTextNode(record.target);
+      else if (record.type === "attributes") translateAttributes(record.target as Element);
+      else record.addedNodes.forEach(walk);
+    }
+  });
+  observer.observe(root, {
+    subtree: true,
+    childList: true,
+    characterData: true,
+    attributes: true,
+    attributeFilter: DISPLAY_ATTRIBUTES,
+  });
+  return () => observer.disconnect();
+}
+
+type DateLocaleMethod = "toLocaleDateString" | "toLocaleTimeString" | "toLocaleString";
+type PatchedFunction = { __paperclipDisplayLocale?: string };
+
+export function installDisplayDateLocale(target: typeof globalThis, locale: string): void {
+  const swap = (requested: unknown) =>
+    requested === undefined || (typeof requested === "string" && /^en(-US)?$/i.test(requested)) ? locale : requested;
+
+  const prototype = target.Date.prototype;
+  for (const name of ["toLocaleDateString", "toLocaleTimeString", "toLocaleString"] as DateLocaleMethod[]) {
+    const original = prototype[name] as ((this: Date, locales?: unknown, options?: unknown) => string) & PatchedFunction;
+    if (original.__paperclipDisplayLocale) continue;
+    const patched = function (this: Date, locales?: unknown, options?: unknown) {
+      return original.call(this, swap(locales), options);
+    } as typeof original;
+    patched.__paperclipDisplayLocale = locale;
+    prototype[name] = patched as Date[DateLocaleMethod];
+  }
+
+  const OriginalDateTimeFormat = target.Intl.DateTimeFormat as typeof Intl.DateTimeFormat & PatchedFunction;
+  if (!OriginalDateTimeFormat.__paperclipDisplayLocale) {
+    const PatchedDateTimeFormat = function (locales?: string | string[], options?: Intl.DateTimeFormatOptions) {
+      const instance = new OriginalDateTimeFormat(locales, options);
+      const displayLocale = swap(locales);
+      if (displayLocale !== locales) {
+        const display = new OriginalDateTimeFormat(displayLocale as string, options);
+        Object.defineProperty(instance, "format", { value: display.format, configurable: true });
+        Object.defineProperty(instance, "formatRange", { value: display.formatRange.bind(display), configurable: true });
+      }
+      return instance;
+    } as unknown as typeof Intl.DateTimeFormat & PatchedFunction;
+    Object.defineProperty(PatchedDateTimeFormat, "prototype", { value: OriginalDateTimeFormat.prototype });
+    Object.defineProperty(PatchedDateTimeFormat, "supportedLocalesOf", {
+      value: OriginalDateTimeFormat.supportedLocalesOf.bind(OriginalDateTimeFormat),
+    });
+    PatchedDateTimeFormat.__paperclipDisplayLocale = locale;
+    Object.defineProperty(target.Intl, "DateTimeFormat", { value: PatchedDateTimeFormat, configurable: true, writable: true });
+  }
+
+  const OriginalRelativeTimeFormat = target.Intl.RelativeTimeFormat as typeof Intl.RelativeTimeFormat & PatchedFunction;
+  if (!OriginalRelativeTimeFormat.__paperclipDisplayLocale) {
+    const PatchedRelativeTimeFormat = function (locales?: string | string[], options?: Intl.RelativeTimeFormatOptions) {
+      return new OriginalRelativeTimeFormat(swap(locales) as string | string[] | undefined, options);
+    } as unknown as typeof Intl.RelativeTimeFormat & PatchedFunction;
+    Object.defineProperty(PatchedRelativeTimeFormat, "prototype", { value: OriginalRelativeTimeFormat.prototype });
+    Object.defineProperty(PatchedRelativeTimeFormat, "supportedLocalesOf", {
+      value: OriginalRelativeTimeFormat.supportedLocalesOf.bind(OriginalRelativeTimeFormat),
+    });
+    PatchedRelativeTimeFormat.__paperclipDisplayLocale = locale;
+    Object.defineProperty(target.Intl, "RelativeTimeFormat", { value: PatchedRelativeTimeFormat, configurable: true, writable: true });
+  }
+}
