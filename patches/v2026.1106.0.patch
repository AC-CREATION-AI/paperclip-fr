@@ -0,0 +1,45 @@
+// @vitest-environment jsdom
+
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { DISPLAY_LOCALE_STORAGE_KEY } from "@/i18n/display-text";
+import { DisplayLanguageSelect } from "./DisplayLanguageSelect";
+
+(globalThis as unknown as { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+describe("DisplayLanguageSelect", () => {
+  afterEach(() => {
+    document.body.innerHTML = "";
+    localStorage.removeItem(DISPLAY_LOCALE_STORAGE_KEY);
+  });
+
+  it("lists the display languages by their own names and stores the choice", async () => {
+    const container = document.createElement("div");
+    document.body.appendChild(container);
+    const onLocaleChange = vi.fn();
+    const root = createRoot(container);
+    await act(async () => {
+      root.render(<DisplayLanguageSelect onLocaleChange={onLocaleChange} />);
+    });
+
+    const select = container.querySelector("select");
+    expect(container.querySelector("label")?.textContent).toContain("Language");
+    expect(select?.value).toBe("en");
+    expect(select?.hasAttribute("data-no-translate")).toBe(true);
+    expect(Array.from(select?.options ?? [], (option) => [option.value, option.textContent])).toEqual([
+      ["en", "English"],
+      ["fr", "Français"],
+    ]);
+
+    await act(async () => {
+      if (!select) return;
+      select.value = "fr";
+      select.dispatchEvent(new Event("change", { bubbles: true }));
+    });
+
+    expect(localStorage.getItem(DISPLAY_LOCALE_STORAGE_KEY)).toBe("fr");
+    expect(onLocaleChange).toHaveBeenCalledWith("fr");
+    await act(async () => root.unmount());
+  });
+});
diff --git a/ui/src/components/DisplayLanguageSelect.tsx b/ui/src/components/DisplayLanguageSelect.tsx
new file mode 100644
index 000000000..f5865e857
--- /dev/null
+++ b/ui/src/components/DisplayLanguageSelect.tsx
@@ -0,0 +1,55 @@
+import { Languages } from "lucide-react";
+
+import { cn } from "@/lib/utils";
+import {
+  DISPLAY_LOCALES,
+  getDisplayLocale,
+  setDisplayLocale,
+  type DisplayLocale,
+} from "@/i18n/display-text";
+
+const LANGUAGE_NAMES: Record<DisplayLocale, string> = {
+  en: "English",
+  fr: "Français",
+};
+
+function isDisplayLocale(value: string): value is DisplayLocale {
+  return (DISPLAY_LOCALES as readonly string[]).includes(value);
+}
+
+interface DisplayLanguageSelectProps {
+  className?: string;
+  onLocaleChange?: (locale: DisplayLocale) => void;
+}
+
+function reloadPage() {
+  window.location.reload();
+}
+
+export function DisplayLanguageSelect({ className, onLocaleChange = reloadPage }: DisplayLanguageSelectProps) {
+  return (
+    <label className={cn("flex items-center gap-2 text-sm text-muted-foreground", className)}>
+      <span className="flex size-5 shrink-0 items-center justify-center">
+        <Languages className="size-4" aria-hidden />
+      </span>
+      <span className="min-w-0 flex-1 truncate">Language</span>
+      <select
+        data-no-translate
+        defaultValue={getDisplayLocale()}
+        onChange={(event) => {
+          const locale = event.target.value;
+          if (!isDisplayLocale(locale)) return;
+          setDisplayLocale(locale);
+          onLocaleChange(locale);
+        }}
+        className="rounded-md border border-border bg-background px-2 py-1 text-sm text-foreground"
+      >
+        {DISPLAY_LOCALES.map((locale) => (
+          <option key={locale} value={locale} lang={locale}>
+            {LANGUAGE_NAMES[locale]}
+          </option>
+        ))}
+      </select>
+    </label>
+  );
+}
